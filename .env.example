# ==========================================================
# LaaBG Remover 2.0
# Copy this file to .env and NEVER commit the real .env.
# ==========================================================

# ---------- Discord secret ----------
DISCORD_TOKEN=PASTE_YOUR_BOT_TOKEN_HERE

# ---------- Branding ----------
BOT_NAME=LaaBG Remover
BOT_VERSION=2.0.0
OWNER_NAME=LaavaBee
OWNER_DISCORD_ID=
OWNER_GITHUB=https://github.com/laavastudios
OWNER_WEBSITE=https://laavastudios.live
PROJECT_GITHUB=https://github.com/laavastudios/LaaBG-Remover-Discord-Bot-NO-API-

# ---------- Local background removal ----------
# Recommended general-quality model:
BG_MODEL=birefnet-general

# Other local models:
# BG_MODEL=birefnet-general-lite
# BG_MODEL=birefnet-portrait
# BG_MODEL=u2net
# BG_MODEL=u2netp
# BG_MODEL=u2net_human_seg
# BG_MODEL=isnet-general-use
# BG_MODEL=isnet-anime

# Keep models off the system drive if desired.
# Relative paths are relative to the bot directory.
REMBG_HOME=./models

# Newer segmentation models usually don't need alpha matting.
# Enable it if you specifically want extra edge refinement.
BG_ALPHA_MATTING=false

# Cheap edge color cleanup for hair/fur/soft edges.
BG_DECONTAMINATE=true

# ---------- Safety / resource limits ----------
MAX_IMAGE_MB=20
MAX_IMAGE_PIXELS=25000000
MAX_OUTPUT_MB=24
UPLOAD_TIMEOUT_SECONDS=120
PROCESS_TIMEOUT_SECONDS=300

# ---------- Components V2 ----------
ACCENT_COLOR=0x7C3AED

# ==========================================================
# EMOJI ALIASES
#
# Accepted:
#   Unicode:                    EMOJI_SUCCESS=✅
#   Server emoji name:          EMOJI_SUCCESS=laava_success
#   Application emoji name:     EMOJI_SUCCESS=laava_success
#   Emoji ID:                   EMOJI_SUCCESS=123456789012345678
#   Full custom markup:         EMOJI_SUCCESS=<:laava_success:123456789012345678>
#   Animated markup:            EMOJI_SUCCESS=<a:laava_success:123456789012345678>
#
# Resolution:
#   1) current server emoji
#   2) bot/application emoji
#   3) Unicode fallback
#
# This lets you use server-specific art while still having a portable
# application-emoji fallback.
# ==========================================================

EMOJI_BRAND=✨
EMOJI_SUCCESS=✅
EMOJI_ERROR=❌
EMOJI_LOADING=⏳
EMOJI_IMAGE=🖼️
EMOJI_GITHUB=🐙
EMOJI_WEBSITE=🌐
EMOJI_HEART=❤️
EMOJI_PING=🏓
EMOJI_INFO=ℹ️
EMOJI_HELP=❓
EMOJI_SPARKLE=✨
