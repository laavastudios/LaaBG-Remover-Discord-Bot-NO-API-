# ==========================================================
# LaaBG Remover - complete configuration
# Copy to .env and NEVER commit the real .env.
# ==========================================================

# ---------- Discord secret ----------
DISCORD_TOKEN=PASTE_YOUR_BOT_TOKEN_HERE

# ---------- Branding ----------
BOT_NAME=LaaBG Remover
BOT_VERSION=1.1.0
OWNER_NAME=LaavaBee
OWNER_DISCORD_ID=
OWNER_GITHUB=https://github.com/laavastudios
OWNER_WEBSITE=https://laavastudios.live
PROJECT_GITHUB=https://github.com/laavastudios/LaaBG-Remover-Discord-Bot-NO-API-

# ---------- Background removal ----------
# u2net = general purpose
# u2net_human_seg = people
# u2netp = faster / lighter
BG_MODEL=u2net
BG_ALPHA_MATTING=true
BG_ALPHA_FOREGROUND_THRESHOLD=240
BG_ALPHA_BACKGROUND_THRESHOLD=10
BG_ALPHA_ERODE_SIZE=10
BG_ALPHA_BASE_SIZE=1000

# ---------- Limits ----------
MAX_IMAGE_MB=20
MAX_IMAGE_PIXELS=25000000
UPLOAD_TIMEOUT_SECONDS=120
PROCESS_TIMEOUT_SECONDS=180

# ---------- UI ----------
ACCENT_COLOR=0x7C3AED

# ==========================================================
# CUSTOM EMOJI ALIASES
#
# Put either:
#   Unicode:                    EMOJI_SUCCESS=✅
#   Server emoji markup:        EMOJI_SUCCESS=<:success:123456789>
#   Animated server emoji:     EMOJI_SUCCESS=<a:success:123456789>
#   Application/bot emoji:      EMOJI_SUCCESS=<:success:123456789>
#   Emoji ID:                   EMOJI_SUCCESS=123456789
#
# The variable name is the alias used by the bot.
# Server emojis work in servers where that emoji exists.
# Application emojis belong to the bot/application and are the
# portable option for the bot's own UI.
#
# You can upload the same-named emoji to both your application
# and your server and choose the exact one by putting its markup
# or ID here.
# ==========================================================

EMOJI_BRAND=✨
EMOJI_SUCCESS=✅
EMOJI_ERROR=❌
EMOJI_LOADING=⏳
EMOJI_IMAGE=🖼️
EMOJI_GITHUB=🐙
EMOJI_WEBSITE=🌐
EMOJI_HEART=❤️
EMOJI_PING=🏓
EMOJI_INFO=ℹ️
EMOJI_HELP=❓
EMOJI_SPARKLE=✨
